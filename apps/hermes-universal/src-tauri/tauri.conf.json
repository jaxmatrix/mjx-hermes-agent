{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes",
  "version": "0.1.0-beta.1",
  "identifier": "com.jaxmatrix.mjx-unofficial-hermes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hermes",
        "width": 420,
        "height": 900,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; font-src 'self' data: tauri: asset: http://tauri.localhost https://tauri.localhost http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDA5N0Q2RkE2QkYyNwpSV1FudjZadmZRbXdEV1M1dk9NeGFrSVlzajdWY1NwQ2xoaTNGREZGMFVrTVAzNTdNZUYyRFM3Uwo=",
      "endpoints": [
        "https://github.com/jaxmatrix/mjx-hermes-agent/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "iOS": {
      "developmentTeam": "6M43WS4436"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      }
    }
  }
}
