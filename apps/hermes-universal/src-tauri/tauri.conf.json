{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes (MJX)",
  "version": "0.0.1",
  "identifier": "com.jaxmatrix.mjx-unofficial-hermes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hermes (MJX)",
        "width": 1280,
        "height": 960,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data: blob: hermes-media: http://hermes-media.localhost https://hermes-media.localhost; frame-src hermes-artifact: http://hermes-artifact.localhost https://hermes-artifact.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; font-src 'self' data: tauri: asset: http://tauri.localhost https://tauri.localhost http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hermes"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDA5N0Q2RkE2QkYyNwpSV1FudjZadmZRbXdEV1M1dk9NeGFrSVlzajdWY1NwQ2xoaTNGREZGMFVrTVAzNTdNZUYyRFM3Uwo=",
      "endpoints": [
        "https://github.com/jaxmatrix/mjx-hermes-agent/releases/download/universal-latest/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "iOS": {
      "developmentTeam": "6M43WS4436",
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ],
        "files": {
          "/usr/share/polkit-1/actions/com.jaxmatrix.hermes.policy": "polkit/com.jaxmatrix.hermes.policy"
        }
      }
    }
  }
}
