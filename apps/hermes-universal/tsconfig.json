{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@hermes/plugin-sdk": ["./src/sdk/index.ts"],
      "@hermes/shared": ["../shared/src/index.ts"],
      "@hermes/shared/gateway-events": ["../shared/src/gateway-events.ts"],
      "@hermes/shared/json-rpc-channel": ["../shared/src/json-rpc-channel.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../shared/src", "../../packages/hermes-sample-plugins"]
}
