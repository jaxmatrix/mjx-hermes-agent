{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": false,
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@hermes/plugin-sdk": ["./src/sdk/universal.ts"],
      "@hermes/shared/ansi": ["../shared/src/ansi.ts"],
      "@hermes/shared/billing": ["../shared/src/billing-types.ts"],
      "@hermes/shared/color": ["../shared/src/color.ts"],
      "@hermes/shared/i18n": ["../shared/src/i18n.ts"],
      "@hermes/shared/translucency": ["../shared/src/translucency.ts"],
      "@hermes/shared": ["../shared/src/index.ts"]
    },
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../shared/src", "../../packages/hermes-sample-plugins"]
}
